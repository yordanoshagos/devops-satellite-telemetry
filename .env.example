

DOCKERHUB_USERNAME=arsemageb
APP_NAME=devops-satellite-telemetry
IMAGE_TAG=sha-3caff4f
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
SLACK_CHANNEL=satellite-alerts

# SMTP settings for Alertmanager email notifications.
# Gmail example: smtp.gmail.com:587 with an App Password.
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=alerts@example.com
SMTP_AUTH_PASSWORD=replace-with-app-password
SMTP_REQUIRE_TLS=true

# Comma-separated list is supported by Alertmanager, e.g.
# ALERT_EMAIL_TO=oncall@example.com,sre@example.com
ALERT_EMAIL_TO=oncall@example.com

